{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Stophy",
  "colors": {
    "primary": "#f5d90a",
    "light": "#f5d90a",
    "dark": "#1c1917"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "dark": "#000000"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://stophy.dev"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["introduction", "quickstart", "authentication", "without-a-key"]
          },
          {
            "group": "Using the API",
            "pages": ["markdown-output", "paging", "errors-and-retries", "credits-and-limits"]
          },
          {
            "group": "Agents",
            "pages": ["mcp", "for-agents"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "https://api.stophy.dev/openapi.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "stophy.dev",
        "href": "https://stophy.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://stophy.dev/signup"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/stophydotdev",
      "github": "https://github.com/stophydotdev"
    }
  }
}
