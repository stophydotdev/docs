  "notes": {
    "google.search": "Filter with `within`, `country`, `language`, and domains to include or exclude. Keys a result does not have are left out. Without a key you get up to 10 results.",
    "google.news": "Search by `query`, or leave it out and pick a `topic` for the top headlines.",
    "google.aiMode": "Returns Google's AI Mode answer as text, with the pages it cites in `sources`.",
    "ai.answer": "Pick the assistant with `engine`: `gemini` or `chatgpt`. Returns its answer and the pages it cites.",
    "linkedin.people.search": "Results come with profile details when LinkedIn shows them publicly. A result without details costs no extra credit.",
    "linkedin.companies.search": "Results come with company page details. A result without details costs no extra credit.",
    "transcript": "Pass a YouTube, TikTok or Instagram link in `video`. Set `includeTimestamps` to get each line with its time. When there are no captions, the audio is transcribed and `transcribedSeconds` says how much. TikTok videos over 3 minutes are refused, and refused calls cost nothing.",
    "youtube.channel": "A cursor expires after 6 hours. Start again from the first page when it does.",
    "reddit.search": "With `type` set to `users` there is one page and no cursor.",
    "tiktok.profile": "The profile's videos come back in `results`. Page with `cursor`.",
    "instagram.profile": "`posts` is the profile's post count. Its latest posts come back in `results`. Page with `cursor`.",
    "airbnb.search": "Returns up to about 110 listings, 18 to a page. Page with `cursor`.",
    "linkedin.posts": "Returns only the few posts LinkedIn shows publicly.",
    "ads.search": "On Meta, `mediaType` keeps image, video or text ads. Pinterest takes `advertiser` and rejects `query`. Google takes `query` only when it is a domain. To search Google by name, find the advertiser id with Ads advertisers first. On LinkedIn, `within` limits how recent the ads are.",
    "appstore.top": "Pick a `chart` (free, paid or grossing), a `device`, a `genre` and a `country`."
  }
