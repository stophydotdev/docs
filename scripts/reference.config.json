  "notes": {
    "google.search": "Filter with `time`, `country`, `language`, `fileType` and domains to include or exclude. Without a key there is no paging.",
    "google.news": "Search by `query`, or leave it out and pick a `topic` for the top headlines.",
    "google.images": "Send `limit` to get fewer images and pay for fewer.",
    "google.scholar": "Each result has a `citesId`. Send it back as `citesId` to list the works that cite it.",
    "google.aiMode": "Returns Google's AI Mode answer as text, with the pages it cites in `sources`.",
    "youtube.transcript": "Send `videoUrl` or `videoId`, not both. Set `includeTimestamps` to get each line with its time.",
    "instagram.transcript": "Send `videoUrl` or `videoId`, not both. Set `includeTimestamps` to get each line with its time. When there are no captions, the audio is transcribed and `transcribedSeconds` says how much, up to 30 minutes.",
    "tiktok.transcript": "Send `videoUrl` or `videoId`, not both. Set `includeTimestamps` to get each line with its time. When there are no captions, the audio is transcribed and `transcribedSeconds` says how much. TikTok videos over 3 minutes are refused, and refused calls cost nothing.",
    "youtube.channel": "A cursor expires after 6 hours. Start again from the first page when it does.",
    "youtube.charts": "Send `limit` to get fewer results and pay for fewer.",
    "tiktok.profile": "The profile's videos come back in `results`. Page with `cursor`.",
    "instagram.profile": "`posts` is the profile's post count. Its latest posts come back in `results`. Page with `cursor`.",
    "reddit.post": "The comments come back in `results`. Page with `cursor`.",
    "linkedin.posts": "Returns only the few posts LinkedIn shows publicly. Send a profile (`profileUrl` or `profileId`) or a company (`companyUrl` or `companyId`), one of the four.",
    "google.maps.search": "Needs both `query` and `location`. Each place comes with its `hours` when Google shows them. Page with `page`.",
    "google.maps.reviews": "Page with `cursor`.",
    "tripadvisor.reviews": "Narrow the reviews with `ratings`, `travelerTypes` and `months`, and order them with `sort`.",
    "meta.ads.search": "`mediaType` keeps image, video, text, meme or image-and-meme ads. `platforms`, `language`, `shownFrom` and `shownTo` use the Ad Library's own filters.",
    "meta.ads.page": "Takes the Facebook page's id, name or link in `advertiser`. Filter with `status`, `mediaType`, `platforms`, `language`, `shownFrom` and `shownTo`.",
    "google.ads.search": "Takes a domain in `query` or `domain`, or an `advertiser`. Google's library does not search by keyword. To search by name, find the advertiser id with Google Ads advertisers first.",
    "linkedin.ads.search": "`within` limits how recent the ads are.",
    "pinterest.ads.search": "Takes `country` and `advertiser` and no keyword.",
    "appstore.top": "Pick a `chart` (free, paid or grossing), a `device`, a `genre` and a `country`. Send `limit` to get fewer apps and pay for fewer.",
    "appstore.search": "Send `limit` to get fewer apps and pay for fewer.",
    "google.play.search": "Send `limit` to get fewer apps and pay for fewer.",
    "amazon.search": "`sort` set to `avgCustomerReview` puts the highest rated first. It does not mean most reviewed.",
    "zillow.search": "Filter by `status`, price, bedrooms, bathrooms, size, lot, year built, home types and features such as `hasPool`. Search words go in `keywords`."
  }
}
